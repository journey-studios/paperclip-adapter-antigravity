+import { describe, expect, it } from "vitest";
+import type { CostByProviderModel } from "@paperclipai/shared";
+import { aggregateProviderCosts } from "./provider-cost-totals";
+
+describe("aggregateProviderCosts", () => {
+  it("counts cached tokens once and reports a full subscription share", () => {
+    const rows = [{
+      provider: "cursor",
+      biller: "cursor",
+      billingType: "subscription_included",
+      model: "composer-2.5",
+      costCents: 0,
+      inputTokens: 111_664,
+      cachedInputTokens: 1_117_177,
+      outputTokens: 14_265,
+      apiRunCount: 0,
+      subscriptionRunCount: 3,
+      subscriptionInputTokens: 111_664,
+      subscriptionCachedInputTokens: 1_117_177,
+      subscriptionOutputTokens: 14_265,
+    }] satisfies CostByProviderModel[];
+
+    const totals = aggregateProviderCosts(rows);
+    expect(totals.totalTokens).toBe(1_243_106);
+    expect(totals.totalSubTokens).toBe(1_243_106);
+    expect(totals.subSharePct).toBe(100);
+    expect(totals.equivalentCostCents).toBe(31);
+  });
+});
diff --git a/ui/src/lib/provider-cost-totals.ts b/ui/src/lib/provider-cost-totals.ts
new file mode 100644
index 000000000..cdf9b7a8f
--- /dev/null
+++ b/ui/src/lib/provider-cost-totals.ts
@@ -0,0 +1,60 @@
+import type { CostByProviderModel } from "@paperclipai/shared";
+import { estimateCursorEquivalentCostUsd } from "./cursor-pricing";
+
+export function aggregateProviderCosts(rows: CostByProviderModel[]) {
+  let inputTokens = 0;
+  let cachedInputTokens = 0;
+  let outputTokens = 0;
+  let costCents = 0;
+  let apiRunCount = 0;
+  let subRunCount = 0;
+  let subInputTokens = 0;
+  let subCachedInputTokens = 0;
+  let subOutputTokens = 0;
+  let equivalentCostUsd = 0;
+  let hasEquivalentCost = false;
+
+  for (const row of rows) {
+    inputTokens += row.inputTokens;
+    cachedInputTokens += row.cachedInputTokens;
+    outputTokens += row.outputTokens;
+    costCents += row.costCents;
+    apiRunCount += row.apiRunCount;
+    subRunCount += row.subscriptionRunCount;
+    subInputTokens += row.subscriptionInputTokens;
+    subCachedInputTokens += row.subscriptionCachedInputTokens;
+    subOutputTokens += row.subscriptionOutputTokens;
+
+    if (row.biller === "cursor") {
+      const estimate = estimateCursorEquivalentCostUsd({
+        model: row.model,
+        inputTokens: row.inputTokens,
+        cachedInputTokens: row.cachedInputTokens,
+        outputTokens: row.outputTokens,
+      });
+      if (estimate != null) {
+        equivalentCostUsd += estimate;
+        hasEquivalentCost = true;
+      }
+    }
+  }
+
+  const totalTokens = inputTokens + cachedInputTokens + outputTokens;
+  const subTokens = subInputTokens + subCachedInputTokens + subOutputTokens;
+
+  return {
+    totalInputTokens: inputTokens,
+    totalCachedInputTokens: cachedInputTokens,
+    totalOutputTokens: outputTokens,
+    totalTokens,
+    totalCostCents: costCents,
+    totalApiRuns: apiRunCount,
+    totalSubRuns: subRunCount,
+    totalSubInputTokens: subInputTokens,
+    totalSubCachedInputTokens: subCachedInputTokens,
+    totalSubOutputTokens: subOutputTokens,
+    totalSubTokens: subTokens,
+    subSharePct: totalTokens > 0 ? Math.min(100, (subTokens / totalTokens) * 100) : 0,
+    equivalentCostCents: hasEquivalentCost ? Math.round(equivalentCostUsd * 100) : null,
+  };
+}
