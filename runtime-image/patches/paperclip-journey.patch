@@ -0,0 +1,36 @@
+export interface CursorPublicRate {
+  inputPerMillionUsd: number;
+  cacheReadPerMillionUsd: number;
+  outputPerMillionUsd: number;
+}
+
+const CURSOR_PUBLIC_RATES: Record<string, CursorPublicRate> = {
+  // Cursor public pricing, verified 2026-10-06.
+  // https://cursor.com/docs/models-and-pricing
+  "composer-2.5": {
+    inputPerMillionUsd: 0.5,
+    cacheReadPerMillionUsd: 0.2,
+    outputPerMillionUsd: 2.5,
+  },
+  "composer-2.5-fast": {
+    inputPerMillionUsd: 3,
+    cacheReadPerMillionUsd: 0.5,
+    outputPerMillionUsd: 15,
+  },
+};
+
+export function estimateCursorEquivalentCostUsd(input: {
+  model: string;
+  inputTokens: number;
+  cachedInputTokens: number;
+  outputTokens: number;
+}): number | null {
+  const rate = CURSOR_PUBLIC_RATES[input.model.trim().toLowerCase()];
+  if (!rate) return null;
+
+  return (
+    input.inputTokens * rate.inputPerMillionUsd +
+    input.cachedInputTokens * rate.cacheReadPerMillionUsd +
+    input.outputTokens * rate.outputPerMillionUsd
+  ) / 1_000_000;
+}
